# limpiador — environment template. Copy to .env (`make setup` does this for you).
# .env is git-ignored; .env.example is committed. Never put real secrets here.

# ----------------------------------------------------------------------------
# Run mode (ARCHITECTURE.md §12, .clauderules §7)
# ----------------------------------------------------------------------------
# mock   = deterministic mock LLM, temp git fixtures, no network, free.
# openai = real OpenAI + real git/github. Costs credits. E2E + evals only.
LIMPIADOR_LLM=mock

# ----------------------------------------------------------------------------
# REAL mode credentials — only needed for `make run`, `make eval`, `make test-e2e`.
# Leave unset for mock-mode development and the default `make test`; the
# real-mode tiers skip gracefully when any of these is missing.
# ----------------------------------------------------------------------------
OPENAI_API_KEY=
GITHUB_TOKEN=

# The THROWAWAY sandbox repo for E2E, e.g. your-user/limpiador-sandbox.
# NEVER point this at a real repository.
LIMPIADOR_SANDBOX_REPO=
